# ===== LPL Cockpit — variables d'environnement (exemple) =====
# En PROD : ne PAS utiliser ce fichier. Les secrets sont injectés par Secret Manager.
# En LOCAL (backfill / tests) : copier en .env et remplir.

# --- BigQuery ---
BQ_PROJECT=ton-projet-gcp
BQ_DATASET=lpl_cockpit
BQ_LOCATION=EU

# --- Shopify (PROD = test-store20.myshopify.com) ---
SHOPIFY_SHOP_URL=test-store20.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx_REGENERER_LE_TOKEN_DIVULGUE
SHOPIFY_API_VERSION=2024-01
TIMEZONE=Europe/Paris
SHOPIFY_REFRESH_DAYS=40

# --- Meta Ads ---
META_ACCESS_TOKEN=EAAxxx
META_ACCOUNT_ID=305450184
META_API_VERSION=v21.0
ADS_REFRESH_DAYS=14

# --- Google Ads (rempli quand l'accès Basic est accordé) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
